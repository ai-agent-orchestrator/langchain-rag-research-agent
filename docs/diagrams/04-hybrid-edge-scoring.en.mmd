flowchart TB
  Q["masked task description · question"] --> SP["sparse · BM25 / TF-IDF<br/>particle stripping · golden-keyword boost"]
  Q --> DN["dense · E5 default (local)<br/>text-embedding-3-large optional"]
  SP --> FU["fusion · RRF or weighted sum<br/>keep segment / source IDs"]
  DN --> FU
  FU --> GT{"passes knob 1 threshold τ?"}
  ON["ontology segments<br/>Constraint · golden-keyword match"] --> PRT["protected-candidate path<br/>bypasses threshold<br/>only when knob 2 ≥ 0.5"]
  GT -->|"none"| EM["EMPTY<br/>BELOW_THRESHOLD"]
  GT -->|"pass"| TOP["top 30 candidates + protected"]
  PRT --> TOP
  TOP --> RR["rerank<br/>BGE-Reranker default (local)<br/>Cohere optional · relevance only"]
  RR --> EC
  subgraph EC["EDGE-SCORE COMPONENTS · RECORDED PER CHUNK"]
    direction LR
    E1["rarity<br/>IDF"] ~~~ E2["golden<br/>phrase"] ~~~ E3["concreteness<br/>numbers · dates"] ~~~ E4["causal · reversal<br/>therefore · whereas"] ~~~ E5["ontology<br/>priority"] ~~~ E6["cliché<br/>penalty"]
  end
  EC --> SC["final score = (1−w)·relevance + w·edge<br/>w = knob 2"]
  RR -.->|"relevance"| SC
  SC --> MMR["MMR diversity · dedupe"] --> OUT["Edge_Filter result<br/>filtered_context + protected items"]
