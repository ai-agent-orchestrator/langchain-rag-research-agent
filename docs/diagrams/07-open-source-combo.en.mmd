flowchart TB
  SRC["original draft · 30–40 pages"]
  subgraph A["A · FEED IT WHOLE (BASELINE)"]
    direction LR
    A1["whole draft into a small model<br/>over the window: front part only<br/>the middle is easy to miss"] --> A2["flat summary<br/>clichés stay<br/>original edges drop out"]
  end
  subgraph B1["B-1 · BUILD A BRIEF WITH THE EQUALIZER"]
    direction LR
    B11["ontology · retrieval · knobs<br/>mark protected items"] --> B12["Token Diet<br/>fit the budget"] --> B13["edge brief<br/>instruction block + data block"]
  end
  subgraph B2["B-2 · SUMMARIZE WITH A LOCAL MODEL AND CHECK"]
    direction LR
    B21["local model<br/>Llama etc.<br/>swappable behind Generator"] --> B22["output check<br/>reject new numbers / IDs<br/>source IDs ⊆ input"] --> B23["summary + source IDs"]
  end
  EV["EVALUATION · same golden-edge list<br/>compare edge recall of A and B"]
  SRC --> A
  SRC --> B1 --> B2
  A2 -.-> EV
  B23 -.-> EV
