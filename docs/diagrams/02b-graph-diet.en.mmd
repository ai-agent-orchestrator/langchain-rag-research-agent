flowchart TB
  START(["previous figure · Edge_Filter result<br/>filtered_context + protected items"]) --> TC{"Token_Check<br/>tokens ≤ model budget?"}
  TC -->|"fits"| FS["Final_Synthesize<br/>golden phrases → logic skeleton<br/>→ source quotes (source IDs)"]
  TC -->|"over"| TD["Token_Diet<br/>drop one unprotected chunk,<br/>lowest-priority ontology first"]
  TD --> DC{"more to drop?<br/>within loop cap?"}
  DC -->|"yes · re-check"| TC
  DC -->|"no"| B3["BUDGET_PROTECTED_OVERFLOW<br/>only protected items left<br/>report, do not cut · human decides"]
  FS --> OC["Output_Check<br/>no new numbers/IDs · sources ⊆ input<br/>final masking"]
  OC --> F(["final_prompt_input<br/>→ local model (Llama etc.)"])
  F -.->|"optional"| GEN["Generate<br/>summarize · re-check output"]
  LS["LangSmith Tracing<br/>all nodes · allow-listed fields only"]
  TD -.-> LS
  FS -.-> LS
