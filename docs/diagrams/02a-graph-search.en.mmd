flowchart TB
  S(["START<br/>raw_draft · task · knobs"]) --> GI["Guard_Input<br/>shared masking · input policy<br/>injected segments excluded + reported"]
  GI --> GB{"policy blocked?"}
  GB -->|"yes"| B1["BLOCKED<br/>record_risk_event<br/>zero generation calls"]
  GB -->|"no"| CI["Chunk_Ingest<br/>structure split · 5-class ontology<br/>causal links"]
  CI --> RT["Retrieve<br/>sparse + dense → knob 1 threshold<br/>top 30 → rerank<br/>no query: class-wise comparison"]
  CI --> PP["Protected_Pick<br/>golden keywords · Constraint segments<br/>bypass threshold · knob 2 ≥ 0.5"]
  RT --> RG{"enough evidence?"}
  RG -->|"no"| B2["REQUEST_MORE<br/>ask for more material<br/>zero generation calls"]
  RG -->|"yes"| EF["Edge_Filter<br/>edge score × knob 2<br/>mark protected items"]
  PP --> EF
  EF --> NEXT(["next figure · to Token_Check"])
