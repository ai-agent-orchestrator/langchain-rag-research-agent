flowchart TB
  S(["START<br/>raw_draft · task · knobs"]) --> GI["Guard_Input<br/>shared masking · input policy<br/>injected segments excluded + reported"]
  S -.->|"logs every node"| LS["LangSmith Tracing<br/>ontology split<br/>surviving edge sentences<br/>allow-listed fields only"]
  GI --> GB{"policy blocked?"}
  GB -->|"yes"| B1["BLOCKED<br/>record_risk_event<br/>zero generation calls"]
  GB -->|"no"| CI["Chunk_Ingest<br/>structure split · 5-class ontology<br/>causal links"]
  CI --> PP["Protected_Pick<br/>golden keywords · Constraint segments<br/>bypass threshold · knob 2 ≥ 0.5"]
  PP --> EF
  CI --> RT["Retrieve<br/>sparse + dense → knob 1 threshold<br/>top 30 → rerank<br/>no query: class-wise comparison"]
  RT --> RG{"enough evidence?"}
  RG -->|"no"| B2["REQUEST_MORE<br/>ask for more material<br/>zero generation calls"]
  RG -->|"yes"| EF["Edge_Filter<br/>edge score × knob 2<br/>mark protected items"]
  EF --> TC{"Token_Check<br/>tokens ≤ model budget?"}
  TC -->|"fits"| FS["Final_Synthesize<br/>golden phrases → logic skeleton<br/>→ source quotes (source IDs)"]
  TC -->|"over"| TD["Token_Diet<br/>drop unprotected items,<br/>lowest-priority ontology first"]
  TD --> DC{"more to drop?<br/>within loop cap?"}
  DC -->|"yes · re-check"| TC
  DC -->|"no"| B3["BUDGET_PROTECTED_OVERFLOW<br/>only protected items left<br/>report, do not cut · human decides"]
  FS --> OC["Output_Check<br/>no new numbers/IDs<br/>sources ⊆ input · final masking"]
  OC --> F(["final_prompt_input<br/>→ Llama backbone agent"])
  F -.->|"optional"| GEN["Generate<br/>local Llama · re-check output"]
